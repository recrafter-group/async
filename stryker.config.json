{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/*", "./scripts/strykerMarkdownReporter.ts"],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.stryker.json",
  "tempDirName": ".stryker/tmp",
  "mutate": [
    "index.ts",
    "src/**/*.+(ts|tsx)",
    "!**/*.test.+(ts|tsx)",
    "!**/*.test.snap.ts"
  ],
  "reporters": ["html", "json", "markdown", "clear-text"],
  "htmlReporter": {
    "fileName": ".stryker/reports/mutation.html"
  },
  "jsonReporter": {
    "fileName": ".stryker/reports/mutation.json"
  },
  "markdownReporter": {
    "fileName": ".stryker/reports/mutation.md"
  }
}
